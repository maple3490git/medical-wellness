# Medical Wellness API — Development environment template
# Copy to .env and fill with real local values. Never commit .env.

# --- Database ---
# PostgreSQL 16 connection string. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local Windows dev example (PostgreSQL service on port 5432):
#   Create a dedicated user/db for development and set DATABASE_URL accordingly.
#   The docker-compose in infrastructure/docker/docker-compose.yml also defines
#   POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD defaults for container dev.
DATABASE_URL="postgresql://medwell:change-me-in-dev@localhost:5432/medical_wellness?schema=public"

# --- Auth ---
# Long random secret used to sign JWT access tokens. Generate with a password manager.
# Example generation (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 255 }))
JWT_SECRET="change-me-with-a-long-random-secret-32-chars-min"
JWT_EXPIRES_IN="1h"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Seed (development only) ---
# Used by `npm run prisma:seed` to create the initial ADMIN account and demo data.
# In production (NODE_ENV=production) the seed refuses to run with the example
# password below unless a strong SEED_ADMIN_PASSWORD is provided explicitly.
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD="ChangeMeDevOnly!2026"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="MedicalWellness"
